# Database Configuration
# SQLite works without a database password. For the optional Compose PostgreSQL service,
# set POSTGRES_PASSWORD and replace DATABASE_URL with a matching, URL-encoded local DSN.
# Existing initialized volumes retain their password: rotate it separately before changing
# the connection settings. Editing this example or Compose does not rotate stored credentials.
DATABASE_URL=sqlite:///ignis.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ignis_trends
POSTGRES_PORT=5432

# API Credentials (Official & Free)
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here
# YouTube's current granular daily defaults: search.list has its own call bucket while the
# remaining endpoints share a unit bucket. Scheduled radar work stops at 70 search calls so at
# least 30 remain available to requested research.
YOUTUBE_SEARCH_DAILY_LIMIT=100
YOUTUBE_OTHER_DAILY_UNIT_LIMIT=10000

# Zero-Knowledge Security Encryption Key (Fernet: AES-128-CBC + HMAC-SHA256, 256-bit key)
# Optional: Auto-generated if empty
IGNIS_ENCRYPTION_KEY=

# Geo & Default Settings
DEFAULT_GEO=VN

# Meta Threads Graph API (Official OAuth 2.0)
# Register an app at https://developers.facebook.com/apps (Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
THREADS_API_VERSION=v1.0

# Instagram Graph API (Official, for Reels ingress)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0

# In-memory insights cache TTL (seconds) for Threads/Reels.
# Defaults to 2 hours (7200s), preventing N+1 queries during 15-minute daemon cycles
# and staying well within Meta Graph API limit (200 calls/user/hour).
META_INSIGHTS_CACHE_TTL_SECONDS=7200
