# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ignis_trends
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ignis_trends
POSTGRES_PORT=5432

# API Credentials (Official & Free)
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here

# Zero-Knowledge Security Encryption Key (Fernet: AES-128-CBC + HMAC-SHA256, 256-bit key)
# Optional: Auto-generated if empty
IGNIS_ENCRYPTION_KEY=

# Geo & Default Settings
DEFAULT_GEO=VN

# Override for the worker's ingress tick, in minutes. Any value above 0 wins over
# SCHEDULER_INTERVAL_SECONDS below; 0 leaves that value in charge. Raise it off 0 only if you
# know your YouTube quota can take the extra passes -- 60 means 24 passes a day against a
# budget that fits 10.
SYNC_INTERVAL_MINUTES=0

# One pass probes up to 10 keywords and a YouTube search.list costs 100 of the 10,000 units a
# free project gets per day, so ~2.4h is what fits.
SCHEDULER_INTERVAL_SECONDS=8640
DISCOVERY_INTERVAL_HOURS=24


# Meta Threads Graph API (Official OAuth 2.0)
# Register an app at https://developers.facebook.com/apps (Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
THREADS_API_VERSION=v1.0

# Instagram Graph API (Official, for Reels ingress)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0

# In-memory insights cache TTL (seconds) for Threads/Reels.
# Defaults to 2 hours (7200s), preventing N+1 queries during 15-minute daemon cycles
# and staying well within Meta Graph API limit (200 calls/user/hour).
META_INSIGHTS_CACHE_TTL_SECONDS=7200
