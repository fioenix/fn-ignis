{
  "$schema": "https://openclaw.dev/schemas/plugin.v1.json",
  "name": "fn-ignis",
  "title": "fnIgnis",
  "version": "0.7.0",
  "description": "Self-hosted mission-bound social evidence collection and Market analysis by FINOLABS",
  "author": "FINOLABS",
  "capabilities": [
    "social_listening",
    "voice_of_customer",
    "opportunity_scoring",
    "mcp_server"
  ],
  "transport": {
    "type": "stdio",
    "command": "python",
    "args": [
      "-m",
      "ignis.interfaces.mcp.server"
    ],
    "env": {
      "DATABASE_URL": "${DATABASE_URL}",
      "DEFAULT_GEO": "${DEFAULT_GEO}",
      "YOUTUBE_API_KEY": "${YOUTUBE_API_KEY}",
      "YOUTUBE_SEARCH_DAILY_LIMIT": "${YOUTUBE_SEARCH_DAILY_LIMIT}",
      "YOUTUBE_OTHER_DAILY_UNIT_LIMIT": "${YOUTUBE_OTHER_DAILY_UNIT_LIMIT}"
    }
  },
  "protocols": {
    "sop": "6_step_market_research",
    "tools_count": 41,
    "prompts": [
      "market_research_pipeline",
      "voice_of_customer_audit"
    ],
    "resources": [
      "fn-ignis://sop/market-research",
      "fn-ignis://methodology/opportunity-index"
    ]
  }
}
