{
  "$schema": "https://openclaw.dev/schemas/plugin.v1.json",
  "name": "fn-ignis",
  "title": "fnIgnis",
  "version": "0.2.0",
  "description": "Unified Self-Hosted Autonomous Trend Intelligence & Market Opportunity Platform by FINOLABS",
  "author": "FINOLABS",
  "capabilities": [
    "trend_monitoring",
    "voice_of_customer",
    "opportunity_scoring",
    "autonomous_discovery",
    "mcp_server"
  ],
  "transport": {
    "type": "stdio",
    "command": "python",
    "args": [
      "-m",
      "ignis.interfaces.mcp.server"
    ],
    "env": {
      "DATABASE_URL": "${DATABASE_URL}",
      "DEFAULT_GEO": "${DEFAULT_GEO}",
      "YOUTUBE_API_KEY": "${YOUTUBE_API_KEY}"
    }
  },
  "protocols": {
    "sop": "6_step_market_research",
    "tools_count": 31,
    "prompts": [
      "market_research_pipeline",
      "voice_of_customer_audit"
    ],
    "resources": [
      "fn-ignis://sop/market-research",
      "fn-ignis://methodology/opportunity-index"
    ]
  }
}
