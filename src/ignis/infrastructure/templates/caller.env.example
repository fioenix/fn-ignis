# Literal caller-owned settings; no shell execution or variable interpolation.
# Omit DATABASE_URL for the caller-local canonical SQLite default.
# Absolute SQLite paths must remain inside the authorized caller root.
# DATABASE_URL=sqlite:////ABSOLUTE/CALLER_ROOT/.fnignis/canonical.sqlite3
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DB_MIN_POOL_SIZE=1
# DB_MAX_POOL_SIZE=3
# YOUTUBE_API_KEY=YOUR_KEY
# YOUTUBE_SEARCH_DAILY_LIMIT=100
# YOUTUBE_OTHER_DAILY_UNIT_LIMIT=10000
# Settings configure consumers; they never authorize a source probe.
