# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ignis_trends
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ignis_trends
POSTGRES_PORT=5432

# API Credentials (Official & Free)
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here

# Zero-Knowledge Security Encryption Key (AES-256 Fernet)
# Optional: Auto-generated if empty
IGNIS_ENCRYPTION_KEY=

# Geo & Default Settings
DEFAULT_GEO=VN
SYNC_INTERVAL_MINUTES=60

